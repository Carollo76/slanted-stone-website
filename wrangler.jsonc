{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slanted-stone-website",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-27",
  "observability": {
    "enabled": true
  },
  // The worker fronts the static build purely to log AI crawler hits and
  // AI-assistant referrals; it always falls through to ASSETS.
  "assets": {
    "directory": "_site",
    "binding": "ASSETS",
    // Static assets are served WITHOUT invoking the worker unless a route is
    // listed here. Every URL on this site is a static asset, so without this the
    // crawler logging would never run. Scoped to HTML and agent-facing files so
    // the worker is not invoked for 32MB of images.
    "run_worker_first": [
      "/",
      "/blog/*",
      "/privacy/*",
      "/llms.txt",
      "/robots.txt",
      "/sitemap.xml",
      "/feed.xml"
    ]
  },
  "analytics_engine_datasets": [
    {
      "binding": "CRAWLER_LOG",
      "dataset": "slantedstone_ai_traffic"
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
